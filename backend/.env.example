PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# JWT_SECRET es obligatorio. El servidor no arranca sin esta variable.
JWT_SECRET=your_jwt_secret_key_here

# Orígenes permitidos por CORS (separados por coma). En producción apunta al dominio del frontend.
# Ejemplo: https://honatu.mx,https://www.honatu.mx
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=honatu
DB_USER=postgres
DB_PASS=postgres
