# ==============================================================================
# HONATU HIDROPONIA – Cloudinary & Environment Template
# ==============================================================================
# Copia este archivo a .env y llena los valores con tus credenciales de Cloudinary.

# Cloudinary Cloud Name (Requerido en Frontend)
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui

# Cloudinary API Key
VITE_CLOUDINARY_API_KEY=tu_api_key_aqui

# Cloudinary Upload Preset (Para subidas directas no autenticadas en frontend)
VITE_CLOUDINARY_UPLOAD_PRESET=honatu_preset

# Carpeta base dentro de Cloudinary
VITE_CLOUDINARY_FOLDER=honatu

# Parámetros de Backend / Scripts de migración
CLOUDINARY_API_SECRET=tu_api_secret_aqui
CLOUDINARY_URL=cloudinary://tu_api_key:tu_api_secret@tu_cloud_name
